{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schwab operator credentials",
  "description": "Paste your keys below.",
  "type": "object",
  "properties": {
    "app_key": {
      "type": "string",
      "title": "App key",
      "propertyOrder": 1,
      "description": "From developer.schwab.com, your app's page",
      "writeOnly": true,
      "format": "password"
    },
    "secret": {
      "type": "string",
      "title": "Secret",
      "propertyOrder": 2,
      "writeOnly": true,
      "format": "password"
    },
    "account_label": {
      "type": "string",
      "title": "account_label",
      "propertyOrder": 3
    },
    "nonce": {
      "type": "string",
      "const": "bold-hawk-42",
      "readOnly": true
    },
    "rendezvous_relay": {
      "type": "string",
      "const": "wss://relay.example",
      "readOnly": true
    }
  },
  "required": [
    "app_key",
    "secret",
    "nonce",
    "rendezvous_relay"
  ],
  "x-delimiter": "@@@",
  "x-courier-kind": "credentials",
  "x-service": "schwab-operator"
}
